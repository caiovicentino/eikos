# Working directories (all scripts read these; defaults in parentheses)
EIKOS_HOME=.                 # data/, snapshots, suites and checkpoints (.)
EIKOS_RUNS=runs              # evaluation outputs (runs)
JEVBENCH_DIR=jevbench        # clone of the JevBench repository: harness + public items (jevbench)
FINDVER_DIR=FinDVer          # clone of FinDVer, for evaluation/gen_suite_fin2.py
RULEARENA_DIR=RuleArena      # clone of RuleArena, for evaluation/gen_suite_rulearena.py
PYTHON=python                # interpreter used by the shell scripts
PROMPT_STYLE=semif           # prompt format of the released models

# Data generation only (data_pipeline/gen_pipeline.py): any OpenAI-compatible endpoint
TEACHER_API_URL=             # e.g. http://localhost:30000/v1/chat/completions
TEACHER_API_KEY=
TEACHER_MODEL=glm-5.3-flash
# GEN_API= / GEN_MODEL=      # optional separate writer endpoint (defaults to the teacher)

# Evaluation of Jev only (evaluation/eval_jev_suite.py)
JEV_API_URL=
JEV_API_KEY=
